# t2d 环境配置模板 — 复制为 .env 并填写。真实密钥绝不提交进 git。
# 未填 DWS/CSS/OBS 段时自动进入"演示数据模式"（本地适配器），界面会显著标识。

# ───────────────────────── APP ─────────────────────────
APP_ENV=dev                        # dev | prod
APP_BRAND=t2d                      # 品牌名（前端展示与邮件文案）
APP_SECRET_KEY=change-me-generate-a-random-string   # 会话 token 签名密钥
APP_DATA_DIR=./var                 # 状态库、文件存储、日志的根目录
APP_DEMO_BANNER=true               # 演示数据模式横幅（无云凭据时强制 true）

# ───────────────────────── MODEL ───────────────────────
# LiteLLM OpenAI 兼容端点（本机代理 :4000）。绝不使用 MaaS /anthropic 路径。
MODEL_API_BASE=http://localhost:4000/v1
MODEL_API_KEY=change-me            # LiteLLM Virtual Key（sk- 开头）
MODEL_NAME=t2d/deepseek-v4.1-flash-1017
MODEL_TIMEOUT_S=120
MODEL_MAX_RETRIES=2                # "应调工具却 stop" 的 nudge 重试上限

# ───────────────────────── STATE DB ────────────────────
# 本地默认 SQLite；上云切 RDS MySQL 8.0 时填 MYSQL_URL，迁移零改动。
STATE_DB_URL=sqlite:///var/state.db
# MYSQL_URL=mysql+pymysql://t2d:<password>@<rds-host>:3306/t2d?charset=utf8mb4
MYSQL_URL=

# ───────────────────────── DWS（业务仓库）──────────────
# 留空 = 演示模式（本地 Postgres 容器模拟 DWS）
DWS_HOST=
DWS_PORT=8000                      # GaussDB(DWS) 默认端口，以控制台连接信息为准
DWS_DATABASE=
DWS_SCHEMA=t2d                     # 独立 Schema
DWS_USER=
DWS_PASSWORD=
DWS_DRAFT_ROLE=t2d_draft           # 草稿查询身份（只读）
DWS_PUBLISHER_ROLE=t2d_publisher   # 发布刷新身份（只读，批准后使用）

# 演示模式业务 Postgres（模拟 DWS）
DEMO_PG_HOST=localhost
DEMO_PG_PORT=5434
DEMO_PG_DATABASE=t2d_biz
DEMO_PG_USER=t2d
DEMO_PG_PASSWORD=t2d-demo-only

# ───────────────────────── CSS（知识检索）───────────────
# 留空 = 演示模式（本地词法+哈希向量混合检索）
CSS_HOST=
CSS_PORT=9200
CSS_SSL=false
CSS_INDEX_PREFIX=t2d_semantic
CSS_USER=
CSS_PASSWORD=

# ───────────────────────── EMBEDDING ───────────────────
# 演示模式不使用 Embedding 模型（词法+字符 n-gram 哈希向量）。
# 真实 CSS 接入时需要：模型来源（MaaS embedding 模型名或自建 API）+ 维度。
EMBEDDING_PROVIDER=none            # none | maas | external
EMBEDDING_MODEL=
EMBEDDING_DIM=0
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=

# ───────────────────────── OBS（文件存储）───────────────
# 留空 = 演示模式（本地卷目录）
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
OBS_SERVER=
OBS_BUCKET=
OBS_REGION=

# ───────────────────────── SANDBOX ─────────────────────
SANDBOX_PROVIDER=opensandbox       # opensandbox
SANDBOX_SERVER=http://localhost:8003
SANDBOX_API_KEY=change-me
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_S=120              # 单沙箱执行上限（任务书默认 120s，可配置）
SANDBOX_CONCURRENCY=1              # 同时运行沙箱任务数上限

# ───────────────────────── TASK LIMITS ─────────────────
TASK_ANALYSIS_CONCURRENCY=2        # 全局分析任务并发
TASK_QUERY_TIMEOUT_S=60            # 单查询超时
TASK_MAX_ROWS=10000                # 查询行数上限
TASK_MAX_RESULT_CELLS=50000        # 结果单元格上限
TASK_MAX_RESULT_BYTES=5242880      # 结果大小上限 (5MB)
TASK_MAX_STEPS=40                  # 单任务 Agent 步数上限
TASK_MAX_TOOL_CALLS=30             # 单任务工具调用上限
TASK_LEASE_SECONDS=30              # 任务租约时长
TASK_HEARTBEAT_SECONDS=10          # 心跳间隔
TASK_MAX_ATTEMPTS=3                # 失败重试上限

# ───────────────────────── Web / Infra ─────────────────
WEB_PORT=5173                      # 仅 dev 模式 Vite
NGINX_PORT=8080                    # 唯一公网入口
API_PORT=8001
WORKER_HEALTH_PORT=8002
